<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProtoBuf.ConnectLoad</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseProtoBuf>true</UseProtoBuf>
    <UseProtoBufTooling>true</UseProtoBufTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- the same set AotDualHostSmoke uses: both stacks, one contract, one host -->
    <ProjectReference Include="../../src/protobuf-net.Connect.AspNetCore/protobuf-net.Connect.AspNetCore.csproj" />
    <PackageReference Include="protobuf-net.Grpc" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

</Project>
