<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProtoBuf.AotDualHostSmoke</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <UseProtoBuf>true</UseProtoBuf>
    <UseProtoBufTooling>true</UseProtoBufTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- both transports, one host. protobuf-net.Grpc comes from the package (as in AotGrpcSmoke, so
         the generated code binds to the shipped surface); protobuf-net.Connect is the local project.
         The local protobuf-net must be referenced alongside protobuf-net.Grpc, which hard-depends on
         2.4.8 where TypeModel lives in the protobuf-net assembly rather than Core. -->
    <ProjectReference Include="../../src/protobuf-net.Connect.AspNetCore/protobuf-net.Connect.AspNetCore.csproj" />
    <PackageReference Include="protobuf-net.Grpc" />
    <PackageReference Include="Grpc.AspNetCore.Server" />
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

</Project>
