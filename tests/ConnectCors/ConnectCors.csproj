<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ProtoBuf.ConnectCorsChecks</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseProtoBuf>true</UseProtoBuf>
    <UseProtoBufTooling>true</UseProtoBufTooling>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/protobuf-net.Connect.AspNetCore/protobuf-net.Connect.AspNetCore.csproj" />
    <!-- the contract vocabulary - [Service], [ProtoService], CallContext - which
         protobuf-net.Connect.AspNetCore deliberately does not reference; see its csproj -->
    <PackageReference Include="protobuf-net.Grpc" />
  </ItemGroup>

</Project>
