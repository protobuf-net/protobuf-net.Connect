<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- The serializer, and with it the build-time tooling: protobuf-net.BuildTools is not a package
         of its own - it ships inside protobuf-net.Core as analyzer assets - so this reference is
         what brings ProtoModelGenerator and ProtoConnectGenerator along. See Directory.Build.targets,
         and ProtoBufSourcePath there for building against a local protobuf-net checkout instead. -->
    <PackageVersion Include="protobuf-net.Core" Version="3.4.28" />
    <PackageVersion Include="protobuf-net" Version="3.4.28" />
  </ItemGroup>

  <ItemGroup>
    <!-- ServerCallContext, Marshaller<T> and CallOptions. Deliberately NOT protobuf-net.Grpc, which
         hard-depends on protobuf-net 2.4.8 where TypeModel lives in the protobuf-net assembly rather
         than in Core; Grpc.Core.Api depends on nothing of ours, so there is no collision. -->
    <PackageVersion Include="Grpc.Core.Api" Version="2.83.0" />
    <!-- kept in step with Grpc.Core.Api; these version together -->
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.83.0" />
    <PackageVersion Include="Grpc.StatusProto" Version="2.83.0" />
    <!-- protoc plus grpc_csharp_plugin, for the contract-first and conformance projects -->
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />

    <!-- PipeReader, for reading a response stream envelope by envelope. On net8.0 System.IO.Pipelines
         is not in the base shared framework - it arrives only via Microsoft.AspNetCore.App, which a
         client library has no business requiring - so it is referenced explicitly. -->
    <PackageVersion Include="System.IO.Pipelines" Version="10.0.12" />

    <PackageVersion Include="Google.Protobuf" Version="3.36.1" />
    <PackageVersion Include="protobuf-net.Grpc" Version="1.3.14" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="All" />
  </ItemGroup>
</Project>
